{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node ./hooks/cursor-session-start.mjs"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node ./hooks/cursor-session-start.mjs"
      }
    ],
    "preToolUse": [
      {
        "command": "node ./hooks/powershell-utf8.mjs",
        "matcher": "Shell"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node ./hooks/allow-shape.mjs",
        "matcher": "shape\\.mjs"
      }
    ]
  }
}
